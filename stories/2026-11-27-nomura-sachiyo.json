  "scenes": [
    {
      "label": "後を追うように",
      "era": "2017年 ― 2020年",
      "headline": "妻を追うように\n旅立った夫",
      "lines": [
        {
          "text": "妻・沙知代さんを失って、わずか2年2か月。野村克也は、後を追うように旅立ちました。",
          "say": "妻・さちよさんを失って、わずか2年2か月。のむらかつやは、後を追うように旅立ちました。",
          "quote": true
        },
        {
          "text": "妻が最後に残した言葉と、彼がとうとう言えなかったひと言があります。"
        }
      ]
    },
    {
      "label": "最期の朝",
      "era": "2017年12月",
      "headline": "「手を握って」",
      "lines": [
        {
          "text": "2017年12月8日の明け方、沙知代さんは「手を握って」と頼み、野村はその手を握りました。",
          "say": "2017年12月8日の明け方、さちよさんは「手を握って」と頼み、のむらはその手を握りました。"
        }
      ]
    },
    {
      "label": "最後の言葉",
      "era": "2017年12月",
      "headline": "最後の言葉",
      "lines": [
        {
          "text": "その日、食卓に突っ伏した妻に「大丈夫か」と声をかけると、返ってきたのは「大丈夫よ」。",
          "say": "その日、食卓につっぷした妻に「大丈夫か」と声をかけると、返ってきたのは「大丈夫よ」。"
        },
        {
          "text": "それが最後の言葉でした。85歳でした。",
          "quote": true
        }
      ]
    },
    {
      "label": "野球か女か",
      "era": "1977年",
      "headline": "「女を取ります」",
      "lines": [
        {
          "text": "40年前、「野球を取るか、女を取るか」と迫られ、「女を取ります」と答えて監督の座を失った男です。"
        }
      ]
    },
    {
      "label": "さみしいね",
      "era": "2018年",
      "headline": "見せなかった涙",
      "lines": [
        {
          "text": "妻を失ってから、人前で涙は見せませんでした。"
        },
        {
          "text": "けれど、ことあるごとに「さみしいね」とこぼしていました。"
        }
      ]
    },
    {
      "label": "ありがとう",
      "era": "2018年",
      "headline": "言えなかったひと言",
      "lines": [
        {
          "text": "お別れの会で、もう一度会えたら何と言いたいかと聞かれると、答えは「『ありがとう』しかない」。"
        },
        {
          "text": "生きているうちに言えなかったその言葉は、のちに本の題名になります。"
        },
        {
          "text": "『ありがとうを言えなくて』。",
          "quote": true
        }
      ]
    },
    {
      "label": "いいコンビ",
      "era": "2020年",
      "headline": "「いいコンビだった」",
      "lines": [
        {
          "text": "息子の克則さんは、両親を「いいコンビだった」と振り返ります。",
          "say": "息子のかつのりさんは、両親を「いいコンビだった」と振り返ります。"
        }
      ]
    },
    {
      "label": "旅立ち",
      "era": "2020年2月",
      "headline": "妻と同じ病",
      "lines": [
        {
          "text": "2020年2月11日、野村克也、84歳。",
          "say": "2020年2月11日、のむらかつや、84歳。"
        },
        {
          "text": "死因は、妻と同じ心不全でした。",
          "quote": true
        }
      ]
    }
  ]
